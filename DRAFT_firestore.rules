rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    
    // --- Validation Helpers ---
    function isValidScore(data) {
      return data.keys().hasAll(['userId', 'username', 'gameMode', 'score', 'timestamp']) 
             && data.keys().size() >= 5 && data.keys().size() <= 6
             && data.userId == request.auth.uid
             && data.username is string && data.username.size() > 0 && data.username.size() <= 32
             && data.gameMode in ['pitch', 'interval', 'imitate', 'vocal']
             && data.score is number && data.score >= 0 && data.score <= 100
             && (data.keys().hasOnly(['userId', 'username', 'gameMode', 'score', 'timestamp', 'avgGap']))
             && (data.get('avgGap', 0) is number)
             && data.timestamp == request.time;
    }

    // --- Leaderboard Rules ---
    match /leaderboard/{scoreId} {
      allow list: if true; // Public leaderboard
      allow get: if true;
      allow create: if isSignedIn() && isValidId(scoreId) && isValidScore(incoming());
      allow update, delete: if false; // Immutable
    }
  }
}
